# ---------------------------------------------------------------------------
# Starcat Helpdesk — MSSQL connection
#
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored; this template is not, so keep it free of secrets.
# ---------------------------------------------------------------------------

# Hostname or IP of the SQL Server instance.
# For a named instance use the host only here and set MSSQL_INSTANCE below.
MSSQL_SERVER=your-sql-host

# Leave blank for a default instance. Example: SQLEXPRESS
MSSQL_INSTANCE=

# Ignored when MSSQL_INSTANCE is set (the SQL Browser service resolves the port).
MSSQL_PORT=1433

MSSQL_DATABASE=StarCat10

# A read-only account is enough — the dashboard never writes.
MSSQL_USER=readonly_user
MSSQL_PASSWORD=

# TLS. Most on-prem servers use a self-signed cert, so trust it explicitly.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
